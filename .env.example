# Copy this file to .env in the project root, or provide equivalent environment variables via systemd.
# App-specific .env files in apps/sborka, apps/WB, apps/OZ are also supported.
# Values below are examples/placeholders. Do not commit real tokens or passwords.

# Common
HOST=127.0.0.1
COOKIE_SECURE=1
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=auto
AUTH_DB_HOST=
AUTH_DB_PORT=5432
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_SSL=disable
SKLAD_DB_HOST=
SKLAD_DB_PORT=5432
SKLAD_DB_NAME=
SKLAD_DB_USER=
SKLAD_DB_PASSWORD=
SKLAD_DB_SSL=disable
SKLAD_CACHE_MS=60000

# sborka proxy
SBORKA_PORT=3008
OZ_BACKEND=http://127.0.0.1:3006
WB_BACKEND=http://127.0.0.1:3007
SBORKA_BOOTSTRAP_SUPERADMIN_LOGIN=
SBORKA_BOOTSTRAP_SUPERADMIN_PASSWORD=
SBORKA_BOOTSTRAP_SUPERADMIN_NAME=
# Set to 1 only when you intentionally want to rotate this local superadmin password.
SBORKA_BOOTSTRAP_SUPERADMIN_RESET=0

# WB
WB_PORT=3007
WB_ROOT_SITE=WB
WB_API_TOKEN=
WB_API_TOKEN_2=
WB_CLIENT_SECRET=
WB_CLIENT_SECRET_2=
WB_STORE_1_ID=store1
WB_STORE_1_NAME=ИП Ирина
WB_STORE_2_ID=store2
WB_STORE_2_NAME=ИП Евгений

# Ozon
OZ_PORT=3006
OZ_ROOT_SITE=OZ
OZON_STORE_1_ID=irina
OZON_STORE_1_NAME=ИП Ирина
OZON_STORE_1_CLIENT_ID=
OZON_STORE_1_API_KEY=
OZON_STORE_2_ID=evgeny
OZON_STORE_2_NAME=ИП Евгений
OZON_STORE_2_CLIENT_ID=
OZON_STORE_2_API_KEY=

# S3 labels storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_BASE=

# Temporary default for old flows. New code should resolve this through location settings.
SKLAD_FBS_WAREHOUSE_ID=30
SKLAD_FBS_WAREHOUSE_NAME=Ижевск FBS нов
MS_FBS_STOCK_WAREHOUSE_NAME=Ижевск FBS нов
